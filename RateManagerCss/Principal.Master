    <!--footer-->
    <%
        Dim reader As System.IO.TextReader

        Dim fileName As String = Request.PhysicalApplicationPath & "/Portal/Modules/footer_" & RateManager.PortalCulture.GetCulture.ToString.Substring(0, 2) & ".htm"
        If System.IO.File.Exists(filename) Then

            reader = New System.IO.StreamReader(fileName, System.Text.Encoding.Default)
            Dim footer As String = reader.ReadToEnd()
            reader.Close()
            Response.Write(footer)
        End If
    %>
    
    <div class="subir">
        <a href="#top">
            <i class="fa fa-arrow-circle-up"></i>
        </a>
    </div>
        
    </form>
</body>
</html>
