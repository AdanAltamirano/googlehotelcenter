<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Principal.master.vb"
    Inherits="RateManager.PrincipalMaster" %>

<%@ Register Src="Portal/Modules/ctrlHeader.ascx" TagName="ctrlHeader" TagPrefix="uc1" %>
<%@ Register Src="Portal/Modules/ctrlMenuLeft.ascx" TagName="ctrlMenuLeft" TagPrefix="uc3" %>
<%@ Register Src="Portal/Modules/ctrlMenuTap.ascx" TagName="ctrlMenuTap" TagPrefix="uc2" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

	
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Sistema de Administración de Tarifas</title>

    <script src="Includes/Script/jquery-1.4.2.min.js" type="text/javascript"></script>

    <link href="Includes/estilos.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script language="JavaScript" type="text/javascript">
        function remove_leftMenu() {
            //David Bustamante
            //Se quita el menu izquierdo para mostrar completo el iframe

            document.getElementById('submenuDiv').style.width = '0px';
            document.getElementById('contenido').style.width = '99%';
        }

        jQuery.noConflict();
        
        jQuery(document).ready(function() {

            jQuery("#idioma").click(function() {
                var e = jQuery("#idiomas");
                e.fadeIn();
                e.queue(function() {
                    setTimeout(function() {
                        e.dequeue();
                    }, 5000);
                });
                e.fadeOut('slow');
            });

            //opcionesIcono y preguntas frecuentes
            jQuery("#opcionesIcono, #linkPreguntasFrecuentes").click(function() {
                jQuery('#loading').show();
                HideMenu();
            });

            jQuery("#submenuDiv .dvhide").hide();

            jQuery("#menuPrincipal ul > li  a").click(function() {
                jQuery("#menuPrincipal ul > li").attr("class", "");
                jQuery("#submenuDiv a").parent("li").attr("class", "");
                var id_div = jQuery(this).attr("href") + "_div";
                jQuery(this).parent("li").attr("class", "activo-main-menu");
                jQuery("#submenuDiv .dvhide").hide();
                jQuery(id_div).show(300);
                jQuery(id_div + " a:first").trigger("click");
                var iframe = document.getElementById("frmPrincipal");
                if (jQuery(id_div + " a:first").attr("href") != undefined) {
                if (jQuery(id_div + " a:first").attr("href") != "#") {

                    window.open(jQuery(id_div + " a:first").attr("href"), "frmPrincipal");
                }
                }
            });
            jQuery('iframe').load(function() {
                jQuery('#loading').hide();
            });
            jQuery(".submenuprin li").click(function() {
                jQuery(this).parent("ul").toggleClass("hovered");

                jQuery('#loading').show();

            });
            //SubMenu
            jQuery("#submenuDiv .submenu li div p a").parent("li").attr("class", "");
            jQuery("#submenuDiv .submenu li div p a").click(function() {
                jQuery('#loading').show();
                jQuery("#submenuDiv .submenu li div p a").parent("li").attr("class", "");
                jQuery("#submenuDiv .submenu li").attr("class", "");
                if (jQuery(this).attr("href") != '#') {
                    jQuery(this).parent("p").parent("div").parent("li").addClass("activo-subSubmenu");
                }
            });

            jQuery("#<%=lnkNameCompany.ClientID %>").click(function() {
                jQuery(".infoHotel").toggle("slow");
            });

            jQuery(".showOptions").click(function() {
                jQuery(this).toggleClass("hideOptions");
            });

            jQuery(".showOptionsLf").click(function() {
                jQuery(this).toggleClass("hideOptionsLf");
            });
        });



        function HideMenu() {
            try {
                jQuery("#submenuDiv .dvhide").hide();
                jQuery("#submenuDiv a").parent().parent().parent().attr("class", "");
                jQuery("#menuPrincipal li").attr("class", "");
            } catch (Error) { }

        }

        //Script para el link de "Subir"
        jQuery(function() {
            jQuery(window).scroll(function() {
                if (jQuery(this).scrollTop() > 100) {
                    jQuery('.subir').fadeIn();
                } else {
                    jQuery('.subir').fadeOut();
                }
            });
            jQuery('.subir a').click(function() {
                jQuery('body,html').animate({
                    scrollTop: 0
                }, 500);
                return false;
            });
        });

    </script>

</head>
<body class="body">
    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server">
    </asp:ScriptManager>
    
    
    <div id="loading">
        <img src="Includes/imagenes/loader.gif" alt="Espere por favor..." />
    </div>
    <div id="header">
        <div style="float: left">
            <img src="Includes/imagenes/logo-internetpower.png" alt="UNIVISIT" height="73px" width="150" hspace="15" vspace="4" /><br
                style="clear: both" />
            <asp:Label ID="lblTitle" runat="server" Text="Label" CssClass="clsHeaderTitle">Sistema de Administración de Hotel</asp:Label>
        </div>
        <div id="headerOptions">
            <div id="botonIdioma" style="float: right;">
                &nbsp; <a href="#url" id="idioma">
                    <%=Me.GetLabel("00092")%>
                    ▼</a>
            </div>
            <div id="idiomas" style="display: none">
                <a href='<%= GeRequestApplicationPath(string.concat("/" , Response.Cookies("groupid").value,  "home.aspx?ididioma=1" ))%> '>
                    <img id="imgspaniol" src='<%=GeRequestApplicationPath("/Images/mexico.gif") %>' border="0"
                        style="margin-right: 4px" /><%=Me.GetLabel("01456")%></a>
                <br />
                <a href='<%= GeRequestApplicationPath(string.concat("/" , Response.Cookies("groupid").value, "home.aspx?ididioma=2"))%> '>
                    <img id="imgenglish" src='<%= GeRequestApplicationPath("/Images/usa.gif")%>' border="0"
                        style="margin-right: 4px" /><%=Me.GetLabel("01457")%></a>
            </div>
            <div id="opcionesIcono" style="float: right;">
                <%If RateManager.PortalCulture.GetCulture().ToString = "es-MX" Then%>
                <a style="text-decoration: none;" runat="server" id="lnkTicket" class="dglink" target="frmPrincipal">
                    <img title='<%=me.getlabel("01314") %>' style="height: 24px;" id="imgTicket" border="0"
                        src='<%=GeRequestApplicationPath("/Images/support_request.png")%>' />
                </a><a style="text-decoration: none;" runat="server" id="lnkTicketList" class="dglink"
                    target="frmPrincipal">
                    <img title='<%=me.getlabel("01315") %>' style="height: 24px;" id="imgTicketList"
                        border="0" src='<%=GeRequestApplicationPath("/Images/support_list.png")%>' />
                </a>
                <%Else%>
                <%-- <td width="80px;" align="right">
                    <td width="27px;" align="right">--%>
                <%End If%>
                <a style="text-decoration: none;" runat="server" id="lnkhelp" class="dglink" target="frmPrincipal">
                    <img style="height: 24px;" id="imghelp" border="0" src='<%=GeRequestApplicationPath("/Images/support_help.png")%>' />
                </a>
            </div>
            <div class="clear">
                <img src="Includes/imagenes/ico-usuario.png" width="8" height="10" />
                <span class="colorSesion">
                    <%=Me.GetLabel("01458")%>,
                    <asp:Label ID="lblUser" runat="server">Usuario</asp:Label>
                </span>|
                <asp:LinkButton runat="server" CausesValidation="false" ID="linkLogOut"> <%=Me.GetLabel("00159")%> <img src="Includes/imagenes/ico-salir.png" width="9" height="10" border =0 /></asp:LinkButton>
            </div>
        </div>
    </div>
    <div id="menuPrincipal">
        <uc2:ctrlMenuTap ID="ctrlMenuTap1" runat="server" />
    </div>
    <div id="nombreHotelDiv">
        <asp:HyperLink ID="lnkNameCompany" runat="server" CssClass="nombreHotel showOptionsLf">Hotel</asp:HyperLink>
        <div class="infoHotel">
            <div id="contentInfo">
            </div>
        </div>
        <div id="inforHotel" style="display: none">
            <asp:Label runat="server" ID="lblInfoHotel"></asp:Label>
        </div>
        <a href="#url" class="sombraBlanca botonOpciones">Ayuda ▼</a> <a href="#url" class="sombraBlanca botonOpciones">
            Opciones ▼</a>
    </div>
    <table border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td valign="top">
                <div id="submenuDiv">
                    <uc3:ctrlMenuLeft ID="ctrlMenuLeft1" runat="server" />
                    <div class="clear">
                        <iframe id="frmChat" src="Chat.aspx" frameborder="0" height="75px" style="margin: 0;
                            padding: 0;" width="100%" scrolling="no"></iframe>
                    </div>
                    <div class="clear" style='text-align: center; display: <%=iif(RateManager.PortalCulture.GetIDCulture =1,"block","none")%>'>
                        <a id="linkPreguntasFrecuentes" target="frmPrincipal" href="<%response.write(GeRequestApplicationPath( "/Documentacion/Preguntasfrecuentes.htm"))%>">
                            Preguntas frecuentes</a>
                    </div>
                </div>
            </td>
            <td style="width: 100%" valign="top">
                <div id="contenido">
                    <div id="Contentpage">
                        <asp:ContentPlaceHolder ID="ContainerPage" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="width: 100%; clear: both;" valign="top">
                <%  
                Dim tr As System.IO.TextReader
                Dim str As String
                
                Dim filename As String = Request.PhysicalApplicationPath & "/Portal/Modules/footer_" & RateManager.PortalCulture.GetCulture.ToString.Substring(0, 2) & ".htm"
                If System.IO.File.Exists(filename) Then
                    
                    tr = New System.IO.StreamReader(filename, System.Text.Encoding.Default)
                    Str = tr.ReadToEnd
                    tr.Close()
                    Response.Write(str)
                End If
                
                %>
            </td>
        </tr>
    </table>
    <div class="subir">
        <a href="#top" boder="0"></a>
    </div>
    
    
    </form>
</body>
</html>
