<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Principal.master.vb"
    Inherits="RateManager.PrincipalMaster" %>

<%@ Register Src="Portal/Modules/ctrlHeader.ascx" TagName="ctrlHeader" TagPrefix="uc1" %>
<%@ Register Src="Portal/Modules/ctrlMenuLeft.ascx" TagName="ctrlMenuLeft" TagPrefix="uc3" %>
<%@ Register Src="Portal/Modules/ctrlMenuTap.ascx" TagName="ctrlMenuTap" TagPrefix="uc2" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

	
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Sistema de Administración de Tarifas</title>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>

    <link href="Includes/estilos.css" rel="stylesheet" type="text/css" />
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
	<link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.7.0/css/all.css' integrity='sha384-lZN37f5QGtY3VHgisS14W3ExzMWZxybE1SJSEsQp9S+oqd12jhcu+A56Ebc1zFSJ' crossorigin='anonymous'>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script language="JavaScript" type="text/javascript">
        function remove_leftMenu() {
            //David Bustamante
            //Se quita el menu izquierdo para mostrar completo el iframe

            document.getElementById('submenuDiv').style.width = '0px';
            document.getElementById('contenido').style.width = '99%';
        }
        jQuery.noConflict();
        
        jQuery(document).ready(function() {

            jQuery("#idioma").click(function() {
                var e = jQuery("#idiomas");
                e.fadeIn();
                e.queue(function() {
                    setTimeout(function() {
                        e.dequeue();
                    }, 5000);
                });
                e.fadeOut('slow');
            });

            //opcionesIcono y preguntas frecuentes
            jQuery("#opcionesIcono, #linkPreguntasFrecuentes").click(function() {
                jQuery('#loading').show();
                HideMenu();
            });

            jQuery("#submenuDiv .dvhide").hide();

            jQuery("#menuPrincipal ul > li  a").click(function() {
                //jQuery("#menuPrincipal ul > li").attr("class", "");
                jQuery("#submenuDiv a").parent("li").attr("class", "");
                var id_div = jQuery(this).attr("href") + "_div";
                //jQuery(this).parent("li").addClass("class", "activo-main-menu");
                jQuery("#submenuDiv .dvhide").hide();
                jQuery(id_div).show(300);
                jQuery(id_div + " a:first").trigger("click");
                var iframe = document.getElementById("frmPrincipal");
                if (jQuery(id_div + " a:first").attr("href") != undefined) {
                if (jQuery(id_div + " a:first").attr("href") != "#") {

                    window.open(jQuery(id_div + " a:first").attr("href"), "frmPrincipal");
                }
                }
            });
            jQuery('iframe').load(function() {
                jQuery('#loading').hide();
            });
            jQuery(".submenuprin li").click(function() {
                jQuery(this).parent("ul").toggleClass("hovered");

                jQuery('#loading').show();

            });
            //SubMenu
            jQuery("#submenuDiv .submenu li div p a").parent("li").attr("class", "");
            jQuery("#submenuDiv .submenu li div p a").click(function() {
                jQuery('#loading').show();
                jQuery("#submenuDiv .submenu li div p a").parent("li").attr("class", "");
                jQuery("#submenuDiv .submenu li").attr("class", "");
                if (jQuery(this).attr("href") != '#') {
                    jQuery(this).parent("p").parent("div").parent("li").addClass("activo-subSubmenu");
                }
            });

            jQuery("#<%=lnkNameCompany.ClientID %>").click(function() {
                jQuery(".infoHotel").toggle("slow");
            });

            jQuery(".showOptions").click(function() {
                jQuery(this).toggleClass("hideOptions");
            });

            jQuery(".showOptionsLf").click(function() {
                jQuery(this).toggleClass("hideOptionsLf");
            });
        });



        function HideMenu() {
            try {
                jQuery("#submenuDiv .dvhide").hide();
                jQuery("#submenuDiv a").parent().parent().parent().attr("class", "");
                jQuery("#menuPrincipal li").removeClass("active");
            } catch (Error) { }

        }

        //Script para el link de "Subir"
        jQuery(function() {
            jQuery(window).scroll(function() {
                if (jQuery(this).scrollTop() > 100) {
                    jQuery('.subir').fadeIn();
                } else {
                    jQuery('.subir').fadeOut();
                }
            });
            jQuery('.subir a').click(function() {
                jQuery('body,html').animate({
                    scrollTop: 0
                }, 500);
                return false;
            });
        });

    </script>

</head>
<body class="body">
    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server">
    </asp:ScriptManager>
    
    <header class="navbar navbar-expand navbar-dark flex-column flex-md-row bd-navbar">
        <a class="navbar-brand mr-0 mr-md-2" aria-label="Bootstrap">
	        <img src="Includes/imagenes/istotipo-internetpowerhotel-blanco.png" style="width: 25px;">
        </a>
        <div id="menuPrincipal" class="navbar-nav-scroll">
            <uc2:ctrlMenuTap ID="ctrlMenuTap1" runat="server" />
        </div>
        <ul class="navbar-nav flex-row ml-md-auto d-none d-md-flex">
			<li class="nav-item dropdown">
				<a class="nav-item nav-link dropdown-toggle mr-md-2" href="#" data-toggle="dropdown" id="headermenu" aria-haspopup="true" aria-expanded="false">
					<i class="fas fa-user"></i>
				</a>
				<div class="dropdown-menu dropdown-menu-right" aria-labelledby="headermenu">
					<div class="header-menu">
						<span><%=Me.GetLabel("01458")%>,</span> <asp:Label ID="lblUser" runat="server">Usuario</asp:Label>
					</div>
					<!-- la condicion debe ser igual a "es-MX" -->
					<%If RateManager.PortalCulture.GetCulture().ToString = "xxx" Then%>
						<a runat="server" id="lnkTicket" class="dropdown-item" target="frmPrincipal">
							<i class="fas fa-user-tie"></i> <%=Me.getlabel("01314") %>
						</a>
						<a runat="server" id="lnkTicketList" class="dropdown-item" target="frmPrincipal">
							<i class="fas fa-file-alt"></i> <%=Me.getlabel("01315") %>
						</a>
					<%End If%>
					<a runat="server" id="lnkhelp" class="dropdown-item" target="frmPrincipal">
						<i class="fas fa-question-circle"></i> Soporte
					</a>
					<asp:LinkButton runat="server" CssClass="dropdown-item" CausesValidation="false" ID="linkLogOut">
						<i class="fas fa-sign-out-alt"></i> <%=Me.GetLabel("00159")%>
					</asp:LinkButton>
				</div>
			</li>
			<li>
				<%If RateManager.PortalCulture.GetCulture().ToString = "es-MX" Then%>
					<a class="nav-item nav-link dropdown-toggle mr-md-2" href="#" data-toggle="dropdown" id="menuLanguage" aria-haspopup="true" aria-expanded="false">
						<img src='<%=GeRequestApplicationPath("/Images/mexico.gif") %>' style="margin-right: 4px" /><%=Me.GetLabel("01456")%></a>
					</a>
				<%Else%>
					<a class="nav-item nav-link dropdown-toggle mr-md-2" href="#" data-toggle="dropdown" id="menuLanguage" aria-haspopup="true" aria-expanded="false">
						<img src='<%=GeRequestApplicationPath("/Images/usa.gif") %>' style="margin-right: 4px" /><%=Me.GetLabel("01457")%></a>
					</a>
				<%End If%>
				<div class="dropdown-menu dropdown-menu-right dropdownLng" aria-labelledby="menuLanguage">
					<%If RateManager.PortalCulture.GetCulture().ToString = "es-MX" Then%>
						<a href='<%= GeRequestApplicationPath(String.Concat("/", Response.Cookies("groupid").Value, "home.aspx?ididioma=2"))%>' class="dropdown-item">
							<img src='<%=GeRequestApplicationPath("/Images/usa.gif") %>' style="margin-right: 4px" /><%=Me.GetLabel("01457")%></a>
						</a>
					<%Else%>
						<a href='<%= GeRequestApplicationPath(String.Concat("/", Response.Cookies("groupid").Value, "home.aspx?ididioma=1"))%>' class="dropdown-item">
							<img src='<%=GeRequestApplicationPath("/Images/mexico.gif") %>' style="margin-right: 4px" /><%=Me.GetLabel("01456")%></a>
						</a>
					<%End If%>
				</div>
			</li>
		</ul>
    </header>
	
    <div id="loading">
        <img src="Includes/imagenes/loader.gif" alt="Espere por favor..." />
    </div>
    <div style="display:none" id="header">
        <asp:Label ID="lblTitle" runat="server" Text="Label" CssClass="clsHeaderTitle">Sistema de Administración de Hotel</asp:Label>
    </div>
    <div id="nombreHotelDiv">
        <asp:HyperLink ID="lnkNameCompany" runat="server" CssClass="nombreHotel showOptionsLf">Hotel</asp:HyperLink>
        <div class="infoHotel">
            <div id="contentInfo">
            </div>
        </div>
        <div id="inforHotel" style="display: none">
            <asp:Label runat="server" ID="lblInfoHotel"></asp:Label>
        </div>
        <a href="#url" class="sombraBlanca botonOpciones">Ayuda ▼</a> <a href="#url" class="sombraBlanca botonOpciones">
            Opciones ▼</a>
    </div>
    <table border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td valign="top">
                <div id="submenuDiv">
                    <uc3:ctrlMenuLeft ID="ctrlMenuLeft1" runat="server" />
                    <div class="clear">
                        <iframe id="frmChat" src="Chat.aspx" frameborder="0" height="75px" style="margin: 0;
                            padding: 0;" width="100%" scrolling="no"></iframe>
                    </div>
                    <div class="clear" style='text-align: center; display: <%=iif(RateManager.PortalCulture.GetIDCulture =1,"block","none")%>'>
                        <a id="linkPreguntasFrecuentes" target="frmPrincipal" href="<%response.Write(GeRequestApplicationPath("/Documentacion/Preguntasfrecuentes.htm"))%>">
                            Preguntas frecuentes</a>
                    </div>
                </div>
            </td>
            <td style="width: 100%" valign="top">
                <div id="contenido">
                    <div id="Contentpage">
                        <asp:ContentPlaceHolder ID="ContainerPage" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </div>
            </td>
        </tr>
        <%--<tr>
            <td colspan="2" style="width: 100%; clear: both;" valign="top">
                <%  
                Dim tr As System.IO.TextReader
                Dim str As String
                
                Dim filename As String = Request.PhysicalApplicationPath & "/Portal/Modules/footer_" & RateManager.PortalCulture.GetCulture.ToString.Substring(0, 2) & ".htm"
                If System.IO.File.Exists(filename) Then
                    
                    tr = New System.IO.StreamReader(filename, System.Text.Encoding.Default)
                    Str = tr.ReadToEnd
                    tr.Close()
                    Response.Write(str)
                End If
                
                %>
            </td>
        </tr>--%>
    </table>

    <!--footer-->
    <%
                                                                   Dim reader As System.IO.TextReader

                                                                   Dim fileName As String = Request.PhysicalApplicationPath & "/Portal/Modules/footer_" & RateManager.PortalCulture.GetCulture.ToString.Substring(0, 2) & ".htm"
                                                                   If System.IO.File.Exists(filename) Then

                                                                       reader = New System.IO.StreamReader(fileName, System.Text.Encoding.Default)
                                                                       Dim footer As String = reader.ReadToEnd()
                                                                       reader.Close()
                                                                       Response.Write(footer)
                                                                   End If
    %>
    
    <div class="subir">
        <a href="#top" boder="0"></a>
    </div>
    
    
    </form>
</body>
</html>
