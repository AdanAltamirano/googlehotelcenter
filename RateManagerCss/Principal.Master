<!DOCTYPE html>
	<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Sistema de Administración de Tarifas</title>
    <link rel="shortcut icon" href="/ratemanager/favicon.ico" type="image/x-icon" />
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <link href="Includes/estilos.css" rel="stylesheet" type="text/css" />
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous /">
	<link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.7.0/css/all.css' integrity='sha384-lZN37f5QGtY3VHgisS14W3ExzMWZxybE1SJSEsQp9S+oqd12jhcu+A56Ebc1zFSJ' crossorigin='anonymous' />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/malihu-custom-scrollbar-plugin/3.1.5/jquery.mCustomScrollbar.min.css">
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/malihu-custom-scrollbar-plugin/3.1.5/jquery.mCustomScrollbar.concat.min.js"></script> 
   
     <!-- SWEET ALERT -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@8.13.0/dist/sweetalert2.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@8.13.0/dist/sweetalert2.all.min.js"></script>
    <script type="text/javascript">
        // HUB de alertas
        var fireAlert = function(alertData){
            var dfd = $.Deferred();
            Swal.fire(alertData).then(function (response) {
                dfd.resolve(response);
            })
            .catch(function (reason) {
                dfd.reject(reason);
            });
            return dfd.promise();
        }

        window.$swal = fireAlert;

    </script>

    <script type="text/javascript" language="javascript">

        window.time = 0;
        window.waitingForceLogout;

        function logout() {

            if (!Swal.isVisible()) {
                Swal.fire({
                    title: '<%=GetLabel("01655") %>',
                    text: '<%=GetLabel("01656") %>',
                    type: 'warning',
                    confirmButtonText: '<%=GetLabel("01657") %>',
                    cancelButtonText: '<%=GetLabel("00159") %>',
                    showCloseButton: false,
                    showCancelButton: true,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                    }).then(function (result) {
                        if (result.value) {
                            console.log('Limpiar')
                            clearTimeout(window.waitingForceLogout);
                            resetTimer();
                        }
                        else {
                            window.location = jQuery('#ctl00_linkLogOut').attr('href');
                    }
                })

                window.waitingForceLogout = setTimeout(forceLogout, 180000);
            }
         }


         function resetTimer() {
            console.log('reset');
            clearTimeout(window.time);
             window.time = setTimeout(logout, 300000)
        }

        function forceLogout() {
            console.log('Force');
            window.location = jQuery('#ctl00_linkLogOut').attr('href');
        }

    </script>


    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script type="text/javascript">
        var interact = false;
        function remove_leftMenu() {
            //David Bustamante
            //Se quita el menu izquierdo para mostrar completo el iframe

            //document.getElementById('submenuDiv').style.width = '0px';
            //document.getElementById('contenido').style.width = '99%';
        }
        jQuery.noConflict();
        
        jQuery(document).ready(function () {

            //opcionesIcono y preguntas frecuentes
            jQuery("#opcionesIcono, #linkPreguntasFrecuentes").click(function() {
                jQuery('#loading').show();
                HideMenu();
            });

            jQuery("#submenuDiv .dvhide").hide();
            /*jQuery('*.dropdown-item[href*="rate-manager-ui"]').click(function () {
                functionSetOptionMenu(jQuery(this)[0].href);
            });*/
            //click menu header
            window.ratemanager_ui = {
                    isUi: false,
                    url: null
                };
            jQuery('#menuPrincipal ul > li a').click(function(){

                var ui = jQuery(this).attr('href').indexOf('rate-manager-ui') > 0;
                window.ratemanager_ui.isUi = ui;
                window.ratemanager_ui.url = (ui ? jQuery(this).attr('href') : null);

                var content_submenu = jQuery(this).attr('href') + '_div';
                HideMenu();
                jQuery(content_submenu).show(300);

                var firstHref = jQuery(content_submenu + ' a:first');
                firstHref.trigger('click');
                
                jQuery('#sidebarContent').show();
                jQuery(this).parent('li').addClass('active');
                    
                setTimeout(function() {
                    jQuery('.dropdown-menu*').removeClass('show');
                }, 100)

                if (firstHref.attr('href') != undefined && firstHref.attr('href') != '#')
                {
                    try
                    {
                        window.open(firstHref.attr('href'), 'frmPrincipal');

                        /**/
                    } catch (error){ }
                }
            })

            jQuery('iframe').load(function() {
                jQuery('#loading').hide();
                this.contentWindow.document.body.offsetHeight + 'px';
                console.log(this.contentWindow.document.body.offsetHeight + 'px');
                if (window.ratemanager_ui.isUi)
                    functionSetOptionMenu(window.ratemanager_ui.url);

                var iframe = jQuery('#frmPrincipal');
                iframe[0].contentWindow.addEventListener("mousemove", function () {
                    resetTimer();
                });                
            });

            jQuery(".submenuprin li").click(function() {
                jQuery(this).parent("ul").toggleClass("hovered");

                jQuery('#loading').show();

            });
            //SubMenu
            jQuery("#submenuDiv .submenu li div p a").parent("li").attr("class", "");
            

            jQuery('#submenuDiv a').click(function(){
                jQuery('#submenuDiv li').removeClass('activo-subSubmenu');
                jQuery(this).parent('li').addClass('activo-subSubmenu');
            })

            <%--jQuery("#<%=lnkNameCompany.ClientID %>").click(function() {
                jQuery(".infoHotel").toggle("slow");
            });--%>

            jQuery(".showOptions").click(function() {
                jQuery(this).toggleClass("hideOptions");
            });

            jQuery(".showOptionsLf").click(function() {
                jQuery(this).toggleClass("hideOptionsLf");
            });
        });
        function HideMenu()
        {
            jQuery('#sidebarContent').hide();
            jQuery('#menuPrincipal li').removeClass('active');
            jQuery('#submenuDiv .dvhide').hide();
        }
        //Script para el link de "Subir"
        jQuery(function() {
            jQuery(window).scroll(function() {
                if (jQuery(this).scrollTop() > 100) {
                    jQuery('.subir').fadeIn();
                } else {
                    jQuery('.subir').fadeOut();
                }
            });
            jQuery('.subir a').click(function() {
                jQuery('body,html').animate({
                    scrollTop: 0
                }, 500);
                return false;
            });


            /*jQuery('#sidebar').mCustomScrollbar({
            	theme: 'minimal'
            })*/

            jQuery('#sidebarCollapse').click(function(){
            	jQuery('#sidebar').addClass('active');
            	jQuery('.overlay').addClass('active');
            	jQuery('.collapse.in').toggleClass('in');
            	jQuery('a[aria-expanded=true]').attr('aria-expanded', 'false');

            })

            jQuery('.dismiss, .overlay').click(function(){
            	jQuery('#sidebar').removeClass('active');
            	jQuery('.overlay').removeClass('active');
            })


            var initEvents = function () {                
                // DOM Events
                document.onmousemove = resetTimer;
                document.onkeydown = resetTimer
             };

            window.onload = function () {
                initEvents();
                resetTimer();
            }




            <%--document.addEventListener("mousemove", function () {
                interact = true;
                console.log(interact);
            });

            //session warning
            var minutes_session = 15;
            var minutes_session_user = 2;
            window.session_counter = 0;
            window.wait_user_counter = 0;

            setInterval(sessionWarning, 60000);
            function sessionWarning() {

                window.session_counter++;
                if (interact === false) {
                    if (window.session_counter >= minutes_session) {
                        if (!Swal.isVisible()) {
                            Swal.fire({
                                title: '<%=GetLabel("01655") %>',
                                text: '<%=GetLabel("01656") %>',
                                type: 'warning',
                                confirmButtonText: '<%=GetLabel("01657") %>',
                                cancelButtonText: '<%=GetLabel("00159") %>',
                                showCloseButton: false,
                                showCancelButton: true,
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then(function (result) {
                                if (result.value) {
                                    window.session_counter = 0;
                                    window.wait_user_counter = 0;
                                    interact = false;
                                }
                                else logOut();
                            })

                            //setInterval(sessionWarningTime, 60000);
                        }
                    }
                }
                else {               
                    interact = false;
                }
            }

            function sessionWarningTime() {
                if (window.session_counter >= minutes_session) {
                    window.wait_user_counter++;
                    if (window.wait_user_counter >= minutes_session_user) logOut();
                }
            }

            jQuery('#frmPrincipal').load(function () {
                window.session_counter = 0;
            })

            function logOut() {
                window.location = jQuery('#ctl00_linkLogOut').attr('href');
            }--%>
        });
    </script>

</head>
<body class="body">
    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server">
    </asp:ScriptManager>
    
    <header class="navbar navbar-expand navbar-dark flex-column flex-md-row bd-navbar">
