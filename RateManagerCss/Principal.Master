	        <img src="Includes/imagenes/istotipo-internetpowerhotel-blanco.png" style="width: 25px;">
        </a>
        <div id="menuPrincipal" class="navbar-nav-scroll">
            <uc2:ctrlMenuTap ID="ctrlMenuTap1" runat="server" />
        </div>
        <ul class="navbar-nav flex-row ml-md-auto d-none d-md-flex">
			<li class="nav-item dropdown">
				<a class="nav-item nav-link dropdown-toggle mr-md-2" href="#" data-toggle="dropdown" id="headermenu" aria-haspopup="true" aria-expanded="false">
					<i class="fas fa-user"></i>
				</a>
				<div class="dropdown-menu dropdown-menu-right" aria-labelledby="headermenu">
					<div class="header-menu">
						<span><%=GetLabel("01458")%>,</span> <asp:Label ID="lblUser" runat="server"></asp:Label>
					</div>
					<!-- la condicion debe ser igual a "es-MX" -->
					<%If RateManager.PortalCulture.GetCulture().ToString = "xxx" Then%>
						<a runat="server" id="lnkTicket" class="dropdown-item" target="frmPrincipal">
							<i class="fas fa-user-tie"></i> <%=GetLabel("01314") %>
						</a>
						<a runat="server" id="lnkTicketList" class="dropdown-item" target="frmPrincipal">
							<i class="fas fa-file-alt"></i> <%=GetLabel("01315") %>
						</a>
					<%End If%>
					<a runat="server" id="lnkhelp" class="dropdown-item" target="frmPrincipal">
						<i class="fas fa-question-circle"></i> <%=GetLabel("01654") %>
					</a>
					<asp:LinkButton runat="server" CssClass="dropdown-item" CausesValidation="false" ID="linkLogOut">
						<i class="fas fa-sign-out-alt"></i> <%=GetLabel("00159")%>
					</asp:LinkButton>
				</div>
			</li>
			<li>
				<%If RateManager.PortalCulture.GetCulture().ToString = "es-MX" Then%>
					<a class="nav-item nav-link dropdown-toggle mr-md-2" href="#" data-toggle="dropdown" id="menuLanguage" aria-haspopup="true" aria-expanded="false">
						<img src='<%=GeRequestApplicationPath("/Images/mexico.gif") %>' style="margin-right: 4px" /><%=GetLabel("01456")%></a>
					</a>
				<%Else%>
					<a class="nav-item nav-link dropdown-toggle mr-md-2" href="#" data-toggle="dropdown" id="menuLanguage" aria-haspopup="true" aria-expanded="false">
						<img src='<%=GeRequestApplicationPath("/Images/usa.gif") %>' style="margin-right: 4px" /><%=GetLabel("01457")%></a>
					</a>
				<%End If%>
				<div class="dropdown-menu dropdown-menu-right dropdownLng" aria-labelledby="menuLanguage">
					<%If RateManager.PortalCulture.GetCulture().ToString = "es-MX" Then%>
						<a href='<%= GeRequestApplicationPath(string.concat("/" , Response.Cookies("groupid").value, "home.aspx?ididioma=2"))%>' class="dropdown-item">
							<img src='<%=GeRequestApplicationPath("/Images/usa.gif") %>' style="margin-right: 4px" /><%=GetLabel("01457")%></a>
						</a>
					<%Else%>
						<a href='<%= GeRequestApplicationPath(string.concat("/" , Response.Cookies("groupid").value,  "home.aspx?ididioma=1" ))%>' class="dropdown-item">
							<img src='<%=GeRequestApplicationPath("/Images/mexico.gif") %>' style="margin-right: 4px" /><%=GetLabel("01456")%></a>
						</a>
					<%End If%>
				</div>
			</li>
		</ul>
    </header>
	
    <div id="loading">
        <img src="Includes/imagenes/loader.gif" alt="Espere por favor..." />
    </div>
    <div style="display:none" id="header">
