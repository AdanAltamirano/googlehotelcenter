		                            padding: 0;" width="100%" scrolling="no"></iframe>
		                    </div>
		                    <div class="clear" style='text-align: center; display: <%=iif(RateManager.PortalCulture.GetIDCulture =1,"block","none")%>'>
		                        <a id="linkPreguntasFrecuentes" target="frmPrincipal" href="<%response.write(GeRequestApplicationPath( "/Documentacion/Preguntasfrecuentes.htm"))%>">
		                            Preguntas frecuentes</a>
		                    </div>
		                </div>
		            </td>--%>
		        </tr>
    		</table>
    	</div>
    </div>

